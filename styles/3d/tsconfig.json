{
  // The browser side: engine, library and each video's visuals3d.ts are plain scripts that share globals
  // (the adapter strips their types with esbuild before the page loads them).
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "preserve",
    "moduleDetection": "legacy",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["gsap"]
  },
  "include": ["globals.d.ts", "three-global.d.ts", "library.ts", "detail.ts", "engine.ts", "../../videos/*/visuals3d.ts"]
}
