{
  // The Node side: core/ (each installed style adds its adapter with styles/<style>/tsconfig.adapter.json). Node runs these .ts files directly (type stripping),
  // so only syntax that can be erased is allowed (no enums, no namespaces). `npm run typecheck` checks the types.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["core/**/*.ts"]
}
